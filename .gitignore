dist/
dist-ssr/
build/
*.local

# Hosting & Cloud Deployment Caches
.firebase/
.vercel/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# Vite, Bundler & Test Caches
.vite/
.cache/
coverage/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
